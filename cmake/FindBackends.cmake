macro(find_and_link_backends target)
    # CUDA
    if(CE_BUILD_CUDA)
        find_package(CUDAToolkit QUIET)
        find_library(CUBLAS_LIBRARY cublas HINTS ${CUDAToolkit_LIBRARY_DIR})
        find_library(CUDNN_LIBRARY cudnn HINTS ${CUDAToolkit_LIBRARY_DIR})

        if(CUDAToolkit_FOUND)
            message(STATUS "CE: CUDA Toolkit found: ${CUDAToolkit_VERSION}")
            target_compile_definitions(${target} PRIVATE CE_HAS_CUDA=1)
            target_link_libraries(${target} PRIVATE CUDA::cudart)
            find_library(CUDA_DRIVER_LIB cuda HINTS ${CUDAToolkit_LIBRARY_DIR})
            if(CUDA_DRIVER_LIB)
                target_link_libraries(${target} PRIVATE ${CUDA_DRIVER_LIB})
            endif()
            if(CUBLAS_LIBRARY)
                target_link_libraries(${target} PRIVATE ${CUBLAS_LIBRARY})
                target_compile_definitions(${target} PRIVATE CE_HAS_CUBLAS=1)
            endif()
            if(CUDNN_LIBRARY)
                target_link_libraries(${target} PRIVATE ${CUDNN_LIBRARY})
                target_compile_definitions(${target} PRIVATE CE_HAS_CUDNN=1)
            endif()
            set_source_files_properties(${CE_CUDA_BACKEND_SOURCES}
                PROPERTIES LANGUAGE CUDA)
            set_target_properties(${target} PROPERTIES
                CUDA_SEPARABLE_COMPILATION ON
                CUDA_ARCHITECTURES "75;80;86;87;89;90")
        else()
            message(WARNING "CE: CUDA Toolkit not found, disabling CUDA backend")
            set_target_sources(${target} PRIVATE ${CE_CUDA_BACKEND_SOURCES})
            set_source_files_properties(${CE_CUDA_BACKEND_SOURCES}
                PROPERTIES HEADER_FILE_ONLY TRUE)
        endif()
    endif()

    # OpenCL
    if(CE_BUILD_OPENCL)
        find_package(OpenCL QUIET)
        if(OpenCL_FOUND)
            message(STATUS "CE: OpenCL found: ${OpenCL_VERSION}")
            target_compile_definitions(${target} PRIVATE CE_HAS_OPENCL=1)
            target_link_libraries(${target} PRIVATE OpenCL::OpenCL)
        else()
            message(WARNING "CE: OpenCL not found, disabling OpenCL backend")
        endif()
    endif()

    # Vulkan
    if(CE_BUILD_VULKAN)
        find_package(Vulkan QUIET)
        if(Vulkan_FOUND)
            message(STATUS "CE: Vulkan found: ${Vulkan_VERSION}")
            target_compile_definitions(${target} PRIVATE CE_HAS_VULKAN=1)
            target_link_libraries(${target} PRIVATE Vulkan::Vulkan)
        else()
            message(WARNING "CE: Vulkan not found, disabling Vulkan backend")
        endif()
    endif()
endmacro()
